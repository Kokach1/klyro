# Extraction Provider Chain: Gemini x N -> OpenAI -> Unavailable
# Primary extraction provider: Comma-separated Gemini API keys rotated in order
GEMINI_API_KEYS=
# Optional single Gemini key fallback
GEMINI_API_KEY=
# Optional Gemini model (default: gemini-1.5-flash)
GEMINI_MODEL=

# Fallback extraction provider: OpenAI (gpt-4o-mini) if all Gemini keys are quota-limited
OPENAI_API_KEY=
OPENAI_MODEL=

# Verification Provider Keys
SERPAPI_API_KEY=
WHOISXML_API_KEY=
OPENCORPORATES_API_KEY=
